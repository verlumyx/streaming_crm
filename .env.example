# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_TIMEZONE=America/Panama

# Database (docker-compose exposes Postgres on 5436)
DATABASE_URL=postgres://streaming_crm:streaming_crm@localhost:5436/streaming_crm
DATABASE_URL_TEST=postgres://streaming_crm:streaming_crm@localhost:5436/streaming_crm_test

# better-auth
BETTER_AUTH_SECRET=change-me-to-a-32-char-random-secret-string
BETTER_AUTH_URL=http://localhost:3000
# Comma-separated extra origins allowed to call the auth API
BETTER_AUTH_TRUSTED_ORIGINS=

# Sales
SALES_GRACE_PERIOD_DAYS=3
# A pending sale reserves its profiles for this long, so the bot cannot oversell inventory
# while a human verifies the payment.
SALES_PENDING_RESERVATION_MINUTES=120

# Secrets at rest (streaming account passwords, channel tokens). Falls back to BETTER_AUTH_SECRET.
APP_ENCRYPTION_KEY=change-me-to-a-32-char-random-secret-string

# Bot IA — Google AI Studio (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=
# Comma-separated fallback chain: the first model that is not rate-limited answers.
BOT_CHAT_MODELS=gemini-2.5-flash-lite
BOT_EMBEDDING_MODEL=gemini-embedding-001
BOT_EMBEDDING_DIMENSIONS=768

# Bot IA — queue worker
BOT_WORKER_SECRET=change-me-random-32-chars
BOT_WORKER_BATCH_SIZE=5
BOT_WORKER_POLL_MS=2000
BOT_WORKER_STUCK_MINUTES=10
# Pending sales the bot registered are auto-rejected after this, freeing the profiles.
BOT_STALE_PENDING_TTL_MINUTES=180
