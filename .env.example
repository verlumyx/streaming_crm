# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_TIMEZONE=America/Panama

# Database (docker-compose exposes Postgres on 5436)
DATABASE_URL=postgres://streaming_crm:streaming_crm@localhost:5436/streaming_crm
DATABASE_URL_TEST=postgres://streaming_crm:streaming_crm@localhost:5436/streaming_crm_test

# better-auth
BETTER_AUTH_SECRET=change-me-to-a-32-char-random-secret-string
BETTER_AUTH_URL=http://localhost:3000
# Comma-separated extra origins allowed to call the auth API
BETTER_AUTH_TRUSTED_ORIGINS=

# Sales
SALES_GRACE_PERIOD_DAYS=3
